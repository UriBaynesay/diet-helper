# Database
# DATABASE_URL below is for host-side dev (npm run dev / db:migrate against the
# Dockerized Postgres published on localhost:5432). docker-compose.yml overrides
# this for the app container itself, pointing it at the "postgres" service host.
DATABASE_URL=postgresql://diet_helper:changeme@localhost:5432/diet_helper
POSTGRES_PASSWORD=changeme

# Claude API (used from Phase 3+ for image extraction, Phase 7 for recipe matching)
ANTHROPIC_API_KEY=

# Cron routes (guard against unauthenticated / tunnel-forwarded requests)
CRON_SECRET=

# Gmail SMTP (daily email, Phase 4)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# App
APP_URL=https://diet.example.com

# Cloudflare
CLOUDFLARE_TUNNEL_TOKEN=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Seed script only, never read at runtime by the app
OWNER_EMAIL=
