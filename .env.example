# Database
# DATABASE_URL below is for host-side dev (npm run dev / db:migrate against the
# Dockerized Postgres published on localhost:5432). docker-compose.yml overrides
# this for the app container itself, pointing it at the "postgres" service host.
DATABASE_URL=postgresql://diet_helper:changeme@localhost:5432/diet_helper
POSTGRES_PASSWORD=changeme

# Claude API (image extraction, recipe-text parsing)
ANTHROPIC_API_KEY=

# Cron routes (guard against unauthenticated requests)
CRON_SECRET=

# Gmail SMTP (daily email)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# App
APP_URL=http://localhost:3000

# Auth — single shared password, protecting the whole app. SESSION_SECRET
# signs the session cookie (jose/HS256); use a long random string, e.g.
# `openssl rand -base64 32`. OWNER_EMAIL identifies the one allowed user row
# in the DB (also used by scripts/seed-owner.ts) and becomes the session's
# identity on successful login.
APP_PASSWORD=
SESSION_SECRET=
OWNER_EMAIL=
